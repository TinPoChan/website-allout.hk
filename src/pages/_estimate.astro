---
import SiteLayout from "../components/SiteLayout.astro";

const waNumber = "85253936777";
---

<SiteLayout
  title="裝修初步估價 | ALL OUT DESIGN"
  description="按實用面積、單位類型及裝修要求，快速取得裝修預算範圍。"
>
  <div class="estimate page-shell">
    <header class="estimate__header">
      <p class="estimate__eyebrow">裝修預算工具</p>
      <h1>初步估價計數機</h1>
      <p>輸入單位資料及裝修要求，即時取得預算範圍。</p>
    </header>

    <div class="estimate__layout">
      <form class="estimate-form" id="estimate-form">
        <section class="form-section" aria-labelledby="area-title">
          <div class="form-section__heading">
            <div>
              <span class="step-number">01</span>
              <h2 id="area-title">實用面積</h2>
            </div>
            <label class="area-value">
              <input id="area-input" type="number" min="100" max="3000" step="1" value="400" inputmode="numeric" />
              <span>呎</span>
            </label>
          </div>
          <input id="area-range" class="area-range" type="range" min="100" max="3000" step="1" value="400" aria-label="實用面積" />
          <div class="range-labels" aria-hidden="true"><span id="area-min-label">100 呎</span><span id="area-max-label">3,000 呎</span></div>
        </section>

        <section class="form-section" aria-labelledby="type-title">
          <div class="form-section__heading">
            <div>
              <span class="step-number">02</span>
              <h2 id="type-title">單位類型</h2>
            </div>
          </div>
          <div class="option-grid option-grid--four">
            <label class="choice"><input type="radio" name="unitType" value="public" /><span>公屋／居屋</span></label>
            <label class="choice"><input type="radio" name="unitType" value="private" checked /><span>私人屋苑</span></label>
            <label class="choice"><input type="radio" name="unitType" value="walkup" /><span>唐樓／單幢</span></label>
            <label class="choice"><input type="radio" name="unitType" value="village" /><span>村屋</span></label>
          </div>
        </section>

        <section class="form-section" aria-labelledby="level-title">
          <div class="form-section__heading">
            <div>
              <span class="step-number">03</span>
              <h2 id="level-title">裝修程度</h2>
            </div>
          </div>
          <div class="option-grid option-grid--two">
            <label class="choice choice--detail">
              <input type="radio" name="level" value="standard" checked />
              <span><strong>全屋裝修</strong><small>拆卸、泥水、水電及全屋翻新</small></span>
            </label>
            <label class="choice choice--detail">
              <input type="radio" name="level" value="premium" />
              <span><strong>高規格全屋裝修</strong><small>升級物料、細緻工藝及個人化訂造</small></span>
            </label>
          </div>
        </section>

        <section class="form-section" id="electricity-section" aria-labelledby="electricity-title">
          <div class="form-section__heading">
            <div>
              <span class="step-number">04</span>
              <h2 id="electricity-title">電制位數量</h2>
            </div>
            <label class="area-value">
              <input id="electricity-points" type="number" min="0" max="300" step="1" value="31" inputmode="numeric" />
              <span>位</span>
            </label>
          </div>
          <p class="form-hint" id="electricity-hint">400 呎私人屋苑建議約 31 位；基準價已包括建議數量，多出或減少會按單位類型調整。</p>
          <p class="form-hint form-hint--detail">費用已包括牆身開槽、暗藏喉管、重新鋪設電線及基本安裝工程，並配施耐德標準開關面板。</p>
        </section>

        <section class="form-section" aria-labelledby="extras-title">
          <div class="form-section__heading">
            <div>
              <span class="step-number">05</span>
              <h2 id="extras-title">其他要求</h2>
            </div>
          </div>
          <div class="extras-grid">
            <label class="toggle-row">
              <span><strong>包括東鵬瓷磚</strong><small>由我們代購及供應；客人自購則不用選</small></span>
              <input type="checkbox" id="tiles" checked />
              <i aria-hidden="true"></i>
            </label>
            <label class="toggle-row">
              <span><strong>全屋訂造傢俬</strong><small>按單位面積及一般全屋配置估算，包括收納櫃、衣櫃及固定傢俬，採用釘裝工藝；並非傢俬逐呎報價</small></span>
              <input type="checkbox" id="furniture" checked />
              <i aria-hidden="true"></i>
            </label>
          </div>
        </section>
      </form>

      <aside class="estimate-result" aria-live="polite">
        <div class="estimate-result__topline">
          <span>初步預算範圍</span>
          <span class="estimate-result__status">即時計算</span>
        </div>
        <div class="estimate-result__amount">
          <strong id="estimate-low">$469,000</strong>
          <span>至</span>
          <strong id="estimate-high">$550,000</strong>
        </div>
        <p class="estimate-result__rate" id="estimate-rate">約 $1,173–$1,375／呎</p>

        <dl class="estimate-summary">
          <div><dt>實用面積</dt><dd id="summary-area">400 呎</dd></div>
          <div><dt>單位類型</dt><dd id="summary-type">私人屋苑</dd></div>
          <div><dt>裝修程度</dt><dd id="summary-level">全屋裝修</dd></div>
          <div><dt>電制位</dt><dd id="summary-electricity">31 位（建議數量）</dd></div>
          <div><dt>其他要求</dt><dd id="summary-extras">包括東鵬瓷磚、訂造傢俬</dd></div>
        </dl>

        <div class="estimate-breakdown">
          <p>預算組成（中位數）</p>
          <dl>
            <div><dt>裝修工程及標準底料</dt><dd id="breakdown-base">$320,000</dd></div>
            <div><dt>電位</dt><dd id="breakdown-electricity">已包建議數量</dd></div>
            <div><dt>東鵬瓷磚</dt><dd id="breakdown-tiles">$20,000</dd></div>
            <div><dt>全屋訂造傢俬</dt><dd id="breakdown-furniture">$169,000</dd></div>
          </dl>
        </div>

        <section class="included-scope" aria-labelledby="included-title">
          <p class="included-scope__eyebrow">預算唔只係一個呎價</p>
          <h2 id="included-title">呢個價錢包括嘅物料與工藝</h2>
          <ul>
            <li><strong>防水</strong><span>西卡 Sika 107 防水物料</span></li>
            <li><strong>水喉</strong><span>英國銅喉</span></li>
            <li><strong>牆身</strong><span>立邦防霉防潮膩子灰</span></li>
            <li><strong>油漆</strong><span id="paint-spec">立邦五合一油漆</span></li>
            <li><strong>泥水</strong><span>硬底工藝鋪磚</span></li>
            <li><strong>瓷磚</strong><span id="tile-spec">包括東鵬瓷磚物料</span></li>
            <li><strong>訂造傢俬</strong><span id="board-spec">包括鵬森 ENF 級免漆實木夾板，採用釘裝工藝</span></li>
          </ul>
          <p>實際型號、顏色、用量及施工範圍會在正式報價列明；冰島漆屬較高成本升級，高規格全屋裝修方案會按選材確認。</p>
        </section>

        <p class="estimate-result__note">只供初步預算參考，實際造價須按現場狀況、設計、物料及工程細節確認。</p>

        <div class="estimate-actions">
          <button class="action action--primary" id="share-image" type="button">分享估價圖片</button>
          <button class="action" id="download-image" type="button">下載圖片</button>
          <a class="action action--whatsapp" id="whatsapp-link" href={`https://wa.me/${waNumber}`} target="_blank" rel="noopener">WhatsApp 查詢</a>
        </div>
      </aside>
    </div>
  </div>
</SiteLayout>

<style>
  .estimate { width: 100%; }
  .estimate__header { max-width: 720px; margin-bottom: 36px; }
  .estimate__eyebrow { margin: 0 0 8px; color: #68737c; font-size: 14px; font-weight: 700; text-transform: uppercase; }
  .estimate__header h1 { margin-bottom: 10px; font-size: clamp(34px, 4vw, 46px); letter-spacing: 0; }
  .estimate__header > p:last-child { margin: 0; color: #4b5359; font-size: 17px; }
  .estimate__layout { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(320px, .75fr); gap: 36px; align-items: start; }
  .estimate-form { min-width: 0; }
  .form-section { padding: 0 0 30px; border-bottom: 1px solid var(--border); margin-bottom: 30px; }
  .form-section__heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
  .form-section__heading > div { display: flex; align-items: center; gap: 12px; }
  .form-section h2 { margin: 0; font-size: 20px; letter-spacing: 0; }
  .step-number { color: #7c878e; font-size: 12px; font-weight: 800; }
  .area-value { display: flex; align-items: center; gap: 7px; }
  .area-value input { width: 104px; height: 44px; border: 1px solid #cfd4d7; border-radius: 6px; padding: 6px 10px; color: #111; background: #fff; font: inherit; font-size: 20px; font-weight: 700; text-align: right; }
  .area-range { width: 100%; height: 5px; margin: 12px 0 8px; accent-color: #111; cursor: pointer; }
  .range-labels { display: flex; justify-content: space-between; color: #7c878e; font-size: 12px; }
  .form-hint { margin: -4px 0 0; color: #68737c; font-size: 13px; line-height: 1.6; }
  .form-hint--detail { margin-top: 7px; color: #4f5960; }
  .option-grid { display: grid; gap: 10px; }
  .option-grid--four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .option-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .choice { position: relative; display: flex; min-height: 54px; align-items: center; justify-content: center; border: 1px solid #d9dddf; border-radius: 6px; padding: 12px; cursor: pointer; text-align: center; }
  .choice:has(input:checked) { border-color: #111; box-shadow: inset 0 0 0 1px #111; background: #f7f8f8; }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice--detail { min-height: 108px; align-items: flex-start; justify-content: flex-start; text-align: left; }
  .choice--detail strong, .choice--detail small { display: block; }
  .choice--detail strong { margin-bottom: 7px; }
  .choice--detail small { color: #68737c; line-height: 1.5; }
  .extras-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .toggle-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 24px; min-height: 128px; border: 1px solid #d9dddf; border-radius: 8px; padding: 24px; cursor: pointer; }
  .toggle-row:has(input:checked) { border-color: #111; background: #f7f8f8; }
  .toggle-row strong, .toggle-row small { display: block; }
  .toggle-row strong { margin-bottom: 6px; font-size: 16px; line-height: 1.35; }
  .toggle-row small { color: #68737c; font-size: 14px; line-height: 1.55; }
  .toggle-row input { position: absolute; opacity: 0; }
  .toggle-row i { position: relative; width: 42px; height: 24px; margin-top: 1px; border-radius: 999px; background: #d5dadd; transition: background .2s; }
  .toggle-row i::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
  .toggle-row input:checked + i { background: #111; }
  .toggle-row input:checked + i::after { transform: translateX(18px); }
  .estimate-result { position: sticky; top: 24px; border: 1px solid #dfe3e5; border-radius: 8px; padding: 26px; background: #fff; box-shadow: 0 12px 30px rgba(13, 27, 35, .07); }
  .estimate-result__topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; color: #4f5960; font-size: 13px; font-weight: 700; }
  .estimate-result__status { color: #287a4a; }
  .estimate-result__amount { display: flex; flex-wrap: wrap; align-items: baseline; gap: 7px; margin-bottom: 5px; }
  .estimate-result__amount strong { font-size: clamp(25px, 3vw, 34px); line-height: 1.15; letter-spacing: 0; }
  .estimate-result__amount span { color: #7c878e; font-size: 13px; }
  .estimate-result__rate { margin: 0 0 24px; color: #68737c; font-size: 13px; }
  .estimate-summary { margin: 0; border-top: 1px solid var(--border); }
  .estimate-summary div { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--border); font-size: 14px; }
  .estimate-summary dt { color: #68737c; }
  .estimate-summary dd { margin: 0; font-weight: 600; text-align: right; }
  .estimate-breakdown { margin-top: 18px; border: 1px solid #e1e5e6; border-radius: 7px; padding: 14px 16px; background: #fafbfb; }
  .estimate-breakdown > p { margin: 0 0 8px; color: #4f5960; font-size: 12px; font-weight: 800; }
  .estimate-breakdown dl { margin: 0; }
  .estimate-breakdown dl div { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; font-size: 12px; }
  .estimate-breakdown dt { color: #68737c; }
  .estimate-breakdown dd { margin: 0; font-weight: 700; text-align: right; }
  .estimate-result__note { margin: 18px 0; color: #737c82; font-size: 12px; line-height: 1.6; }
  .included-scope { margin: 22px 0; border: 1px solid #dde3df; border-radius: 8px; padding: 18px; background: #f7faf8; }
  .included-scope__eyebrow { margin: 0 0 5px; color: #287a4a; font-size: 11px; font-weight: 800; letter-spacing: .05em; }
  .included-scope h2 { margin: 0 0 14px; font-size: 17px; line-height: 1.4; letter-spacing: 0; }
  .included-scope ul { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }
  .included-scope li { display: grid; grid-template-columns: 74px 1fr; gap: 9px; font-size: 13px; line-height: 1.45; }
  .included-scope li strong { color: #26312b; }
  .included-scope li span { color: #56625b; }
  .included-scope > p:last-child { margin: 14px 0 0; border-top: 1px solid #dde3df; padding-top: 12px; color: #68736d; font-size: 11px; line-height: 1.6; }
  .estimate-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .action { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #cfd4d7; border-radius: 6px; padding: 9px 12px; background: #fff; color: #111; font: inherit; font-weight: 700; cursor: pointer; text-align: center; }
  .action:hover { border-color: #111; color: #111; }
  .action--primary { grid-column: 1 / -1; border-color: #111; background: #111; color: #fff; }
  .action--primary:hover { background: #303030; color: #fff; }
  .action--whatsapp { border-color: #218b4e; color: #176c3b; }
  @media (max-width: 900px) {
    .estimate__layout { grid-template-columns: 1fr; }
    .estimate-result { position: static; }
  }
  @media (max-width: 640px) {
    .estimate__header { margin-bottom: 28px; }
    .estimate__header > p:last-child { font-size: 16px; }
    .option-grid--four, .option-grid--two { grid-template-columns: 1fr 1fr; }
    .extras-grid { grid-template-columns: 1fr; }
    .toggle-row { min-height: 0; padding: 20px; }
    .estimate-result { padding: 20px; }
  }
  @media (max-width: 420px) {
    .option-grid--four, .extras-grid { grid-template-columns: 1fr; }
    .estimate-actions { grid-template-columns: 1fr; }
    .action--primary { grid-column: auto; }
  }
</style>

<script is:inline define:vars={{ waNumber }}>
  const PRICING = {
    rateByUnit: {
      public: { standard: 575, premium: 750 },
      private: { standard: 800, premium: 1000 },
      walkup: { standard: 900, premium: 1100 },
      village: { standard: 850, premium: 1050 },
    },
    electricityPointRate: { public: 800, private: 1000, walkup: 1000, village: 1000 },
    tilesRate: 50,
    furnitureAnchor: { area: 384, amount: 166000 },
    range: 0.08,
  };

  const LABELS = {
    unitType: { public: "公屋／居屋", private: "私人屋苑", walkup: "唐樓／單幢", village: "村屋" },
    level: { standard: "全屋裝修", premium: "高規格全屋裝修" },
  };

  const AREA_LIMITS = {
    public: { min: 150, max: 862 },
    default: { min: 100, max: 3000 },
  };

  const ELECTRICITY_POINT_ANCHORS = {
    smaller: { area: 384, points: 30 },
    larger: { area: 807, points: 50 },
  };

  const form = document.querySelector("#estimate-form");
  const areaInput = document.querySelector("#area-input");
  const areaRange = document.querySelector("#area-range");
  const areaMinLabel = document.querySelector("#area-min-label");
  const areaMaxLabel = document.querySelector("#area-max-label");
  const electricityPoints = document.querySelector("#electricity-points");
  const money = new Intl.NumberFormat("zh-HK", { style: "currency", currency: "HKD", maximumFractionDigits: 0 });
  let electricityPointsEdited = false;

  function selected(name) {
    return form.querySelector(`input[name="${name}"]:checked`).value;
  }

  function getState() {
    const unitType = selected("unitType");
    const limits = unitType === "public" ? AREA_LIMITS.public : AREA_LIMITS.default;
    const area = Math.max(limits.min, Math.min(limits.max, Number(areaInput.value) || limits.min));
    return {
      area,
      unitType,
      level: selected("level"),
      electricityPoints: Math.max(0, Math.min(300, Math.round(Number(electricityPoints.value) || 0))),
      tiles: document.querySelector("#tiles").checked,
      furniture: document.querySelector("#furniture").checked,
    };
  }

  function recommendedElectricityPoints(area) {
    const { smaller, larger } = ELECTRICITY_POINT_ANCHORS;
    const slope = (larger.points - smaller.points) / (larger.area - smaller.area);
    return Math.max(1, Math.round(smaller.points + (area - smaller.area) * slope));
  }

  function applyAreaLimits(unitType, useUnitDefault = false) {
    const limits = unitType === "public" ? AREA_LIMITS.public : AREA_LIMITS.default;
    areaInput.min = limits.min;
    areaInput.max = limits.max;
    areaRange.min = limits.min;
    areaRange.max = limits.max;
    areaMinLabel.textContent = `${limits.min.toLocaleString("zh-HK")} 呎`;
    areaMaxLabel.textContent = `${limits.max.toLocaleString("zh-HK")} 呎`;

    const currentArea = useUnitDefault && unitType === "public"
      ? 384
      : Number(areaInput.value) || limits.min;
    const clampedArea = Math.max(limits.min, Math.min(limits.max, currentArea));
    areaInput.value = clampedArea;
    areaRange.value = clampedArea;
  }

  function calculate(state) {
    const base = state.area * PRICING.rateByUnit[state.unitType][state.level];
    const electricityAdjustment = (state.electricityPoints - recommendedElectricityPoints(state.area)) * PRICING.electricityPointRate[state.unitType];
    const tiles = state.tiles ? state.area * PRICING.tilesRate : 0;
    const furniture = state.furniture
      ? PRICING.furnitureAnchor.amount * Math.sqrt(state.area / PRICING.furnitureAnchor.area)
      : 0;
    const total = Math.max(0, base + electricityAdjustment + tiles + furniture);
    const round = (value) => Math.round(value / 1000) * 1000;
    return {
      low: round(total * (1 - PRICING.range)),
      high: round(total * (1 + PRICING.range)),
      base: round(base),
      electricityAdjustment: round(electricityAdjustment),
      tiles: round(tiles),
      furniture: round(furniture),
    };
  }

  function extrasText(state) {
    const extras = [];
    if (state.tiles) extras.push("包括東鵬瓷磚");
    if (state.furniture) extras.push("訂造傢俬");
    return extras.length ? extras.join("、") : "不包括";
  }

  function render() {
    const state = getState();
    const result = calculate(state);
    document.querySelector("#estimate-low").textContent = money.format(result.low);
    document.querySelector("#estimate-high").textContent = money.format(result.high);
    document.querySelector("#estimate-rate").textContent = `約 ${money.format(Math.round(result.low / state.area))}–${money.format(Math.round(result.high / state.area))}／呎`;
    document.querySelector("#summary-area").textContent = `${state.area.toLocaleString("zh-HK")} 呎`;
    document.querySelector("#summary-type").textContent = LABELS.unitType[state.unitType];
    document.querySelector("#summary-level").textContent = LABELS.level[state.level];
    const recommendedPoints = recommendedElectricityPoints(state.area);
    document.querySelector("#summary-electricity").textContent = `${state.electricityPoints} 位${state.electricityPoints === recommendedPoints ? "（建議數量）" : ""}`;
    document.querySelector("#summary-extras").textContent = extrasText(state);
    document.querySelector("#breakdown-base").textContent = money.format(result.base);
    document.querySelector("#breakdown-electricity").textContent = result.electricityAdjustment === 0
      ? "已包建議數量"
      : `${result.electricityAdjustment > 0 ? "+" : "−"}${money.format(Math.abs(result.electricityAdjustment))}`;
    document.querySelector("#breakdown-tiles").textContent = state.tiles ? money.format(result.tiles) : "不包括";
    document.querySelector("#breakdown-furniture").textContent = state.furniture ? money.format(result.furniture) : "不包括";
    document.querySelector("#electricity-hint").textContent = `${state.area.toLocaleString("zh-HK")} 呎建議約 ${recommendedPoints} 位；基準價已包括建議數量，多出或減少會按每位 ${money.format(PRICING.electricityPointRate[state.unitType])} 調整。`;
    document.querySelector("#paint-spec").textContent = state.level === "premium" ? "冰島漆升級規格（按最終選材確認）" : "立邦五合一油漆";
    document.querySelector("#tile-spec").textContent = state.tiles ? "包括東鵬瓷磚物料" : "客人自購；可選用東鵬瓷磚物料";
    document.querySelector("#board-spec").textContent = state.furniture
      ? "包括鵬森 ENF 級免漆實木夾板，採用釘裝工藝"
      : "未包括；選配採用鵬森 ENF 級免漆實木夾板及釘裝工藝";
    const text = `你好，我想查詢裝修報價。\n實用面積：${state.area} 呎\n單位類型：${LABELS.unitType[state.unitType]}\n裝修程度：${LABELS.level[state.level]}\n電制位：${state.electricityPoints} 位\n其他要求：${extrasText(state)}\n初步預算：${money.format(result.low)} 至 ${money.format(result.high)}`;
    document.querySelector("#whatsapp-link").href = `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
    return { state, result };
  }

  function roundedRect(ctx, x, y, width, height, radius) {
    ctx.beginPath();
    ctx.roundRect(x, y, width, height, radius);
    ctx.fill();
  }

  async function createImageFile() {
    const { state, result } = render();
    const canvas = document.createElement("canvas");
    canvas.width = 1200;
    canvas.height = 2100;
    const ctx = canvas.getContext("2d");
    ctx.fillStyle = "#f3f5f5";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "#ffffff";
    roundedRect(ctx, 70, 70, 1060, 1960, 24);
    ctx.fillStyle = "#111111";
    ctx.font = "700 38px system-ui, sans-serif";
    ctx.fillText("ALL OUT DESIGN", 130, 155);
    ctx.fillStyle = "#68737c";
    ctx.font = "600 26px system-ui, sans-serif";
    ctx.fillText("裝修初步估價", 130, 225);
    ctx.fillStyle = "#111111";
    ctx.font = "700 60px system-ui, sans-serif";
    ctx.fillText(`${money.format(result.low)} –`, 130, 350);
    ctx.fillText(money.format(result.high), 130, 430);
    ctx.fillStyle = "#68737c";
    ctx.font = "400 25px system-ui, sans-serif";
    ctx.fillText(`約 ${money.format(Math.round(result.low / state.area))}–${money.format(Math.round(result.high / state.area))}／呎`, 130, 485);
    ctx.strokeStyle = "#e3e6e7";
    ctx.beginPath(); ctx.moveTo(130, 545); ctx.lineTo(1070, 545); ctx.stroke();
    const rows = [
      ["實用面積", `${state.area.toLocaleString("zh-HK")} 呎`],
      ["單位類型", LABELS.unitType[state.unitType]],
      ["裝修程度", LABELS.level[state.level]],
      ["電制位", `${state.electricityPoints} 位`],
      ["其他要求", extrasText(state)],
    ];
    rows.forEach(([label, value], index) => {
      const y = 615 + index * 95;
      ctx.fillStyle = "#68737c"; ctx.font = "400 25px system-ui, sans-serif"; ctx.fillText(label, 130, y);
      ctx.fillStyle = "#111111"; ctx.font = "600 28px system-ui, sans-serif"; ctx.textAlign = "right"; ctx.fillText(value, 1070, y); ctx.textAlign = "left";
      ctx.strokeStyle = "#eceeef"; ctx.beginPath(); ctx.moveTo(130, y + 38); ctx.lineTo(1070, y + 38); ctx.stroke();
    });

    const materialRows = [
      ["防水", "西卡 Sika 107 防水物料"],
      ["水喉", "英國銅喉"],
      ["牆身", "立邦防霉防潮膩子灰"],
      ["油漆", state.level === "premium" ? "冰島漆升級規格（按最終選材確認）" : "立邦五合一油漆"],
      ["電力", "開槽、暗喉、重新鋪線及施耐德標準面板"],
      ["泥水", "硬底工藝鋪磚"],
      ["瓷磚", state.tiles ? "包括東鵬瓷磚物料" : "未包括（客人自購）"],
      ["訂造傢俬", state.furniture ? "鵬森 ENF 級免漆實木夾板、釘裝工藝" : "未包括"],
    ];
    ctx.fillStyle = "#f7faf8";
    roundedRect(ctx, 130, 1080, 940, 640, 14);
    ctx.fillStyle = "#287a4a";
    ctx.font = "700 18px system-ui, sans-serif";
    ctx.fillText("預算唔只係一個呎價", 170, 1130);
    ctx.fillStyle = "#111111";
    ctx.font = "700 30px system-ui, sans-serif";
    ctx.fillText("包括物料與工藝", 170, 1175);
    materialRows.forEach(([label, value], index) => {
      const y = 1235 + index * 58;
      ctx.fillStyle = "#26312b";
      ctx.font = "700 21px system-ui, sans-serif";
      ctx.fillText(label, 170, y);
      ctx.fillStyle = "#56625b";
      ctx.font = "400 21px system-ui, sans-serif";
      ctx.fillText(value, 340, y);
    });
    ctx.strokeStyle = "#dce5df";
    ctx.beginPath(); ctx.moveTo(170, 1680); ctx.lineTo(1030, 1680); ctx.stroke();
    ctx.fillStyle = "#68736d";
    ctx.font = "400 17px system-ui, sans-serif";
    ctx.fillText("實際型號、用量及施工範圍會在正式報價列明。", 170, 1708);

    ctx.fillStyle = "#f3f5f5";
    roundedRect(ctx, 130, 1750, 940, 150, 12);
    ctx.fillStyle = "#59646b";
    ctx.font = "400 22px system-ui, sans-serif";
    ctx.fillText("此估價只供初步預算參考。實際造價須按現場狀況、", 170, 1810);
    ctx.fillText("設計、物料及工程細節確認。", 170, 1855);
    ctx.fillStyle = "#111111";
    ctx.font = "600 24px system-ui, sans-serif";
    ctx.fillText("allout.hk", 130, 1980);
    const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/png"));
    return new File([blob], "all-out-design-estimate.png", { type: "image/png" });
  }

  function syncRecommendedElectricityPoints() {
    if (!electricityPointsEdited) {
      electricityPoints.value = recommendedElectricityPoints(Number(areaInput.value) || 100);
    }
  }

  areaRange.addEventListener("input", () => { areaInput.value = areaRange.value; syncRecommendedElectricityPoints(); render(); });
  areaInput.addEventListener("input", () => { areaRange.value = areaInput.value; syncRecommendedElectricityPoints(); render(); });
  electricityPoints.addEventListener("input", () => { electricityPointsEdited = true; render(); });
  form.addEventListener("change", (event) => {
    if (event.target.name === "unitType") {
      applyAreaLimits(event.target.value, true);
      electricityPointsEdited = false;
      syncRecommendedElectricityPoints();
    } else if (event.target === areaInput) {
      applyAreaLimits(selected("unitType"));
      syncRecommendedElectricityPoints();
    }
    render();
  });

  document.querySelector("#download-image").addEventListener("click", async () => {
    const file = await createImageFile();
    const url = URL.createObjectURL(file);
    const link = document.createElement("a");
    link.href = url; link.download = file.name; link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  document.querySelector("#share-image").addEventListener("click", async () => {
    const file = await createImageFile();
    if (navigator.canShare?.({ files: [file] })) {
      try { await navigator.share({ files: [file], title: "ALL OUT DESIGN 裝修初步估價" }); } catch (error) { if (error.name !== "AbortError") console.error(error); }
      return;
    }
    const url = URL.createObjectURL(file);
    const link = document.createElement("a");
    link.href = url; link.download = file.name; link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  render();
</script>
