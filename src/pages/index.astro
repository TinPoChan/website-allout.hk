---
import SiteLayout from "../components/SiteLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import { Image } from "astro:assets";
import MountHavenCover from "../assets/MountHavenCover.jpeg";
import CheungTungEstateCover from "../assets/CheungTungEstateCover.jpeg";
import OnWahCourtCover from "../assets/OnWahCourtCover.png";
import Home from "../assets/Home.jpg";

const waLink = "https://wa.me/85253936777";

// 你可以之後改成由 content collection 拉 featured projects
const featured = [
  {
    title: "青衣曉峰園全屋裝修",
    subtitle: "青衣住宅｜548呎｜木系風格",
    image: MountHavenCover,
    href: "/projects/tsing-yi-mounthaven-548-renovation",
  },
  {
    title: "東涌翔東邨全屋裝修",
    subtitle: "公共屋邨｜327呎｜現代簡約",
    image: CheungTungEstateCover,
    href: "/projects/TungChung-CheungTungEstate-327-renovation",
  },
  {
    title: "觀塘安樺苑全屋裝修",
    subtitle: "居屋屋苑｜408呎｜溫馨簡約",
    image: OnWahCourtCover,
    href: "/projects/KwunTong-OnWahCourt-408-renovation",
  },
];

const process = [
  { no: "01", zh: "需求諮詢", en: "Initial Consultation" },
  { no: "02", zh: "設計方案", en: "Design Proposal" },
  { no: "03", zh: "報價合約", en: "Quotation & Contract" },
  { no: "04", zh: "竣工交付", en: "Project Handover" },
];

const services = [
  {
    zh: "全屋翻新",
    en: "Full Renovation",
    items: ["浴室廚房翻新", "鋪磚油漆", "傢俬訂造"],
  },
  {
    zh: "局部工程",
    en: "Partial Renovation",
    items: ["拆卸間隔", "水電改動", "防水工程"],
  },
  {
    zh: "設計＋施工",
    en: "Design & Build",
    items: ["概念設計", "工程監督", "物料採購"],
  },
];
---

<SiteLayout
  title="ALL OUT DESIGN LIMITED｜室內設計與裝修工程"
  description="展示作品案例與裝修設計專欄，分享工程流程、物料選擇與避坑指南。"
>
<JsonLd type="organization" />
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="hero__kicker">住宅室內設計｜裝修工程｜傢俬訂造</div>
        <h1 class="hero__title">設計得好，<br class="mobile-only" />也要裝修做得到。</h1>
        <p class="hero__desc">
          <span>ALL OUT DESIGN 提供住宅室內設計、裝修工程及傢俬訂造服務。</span>
          <span>由空間規劃、報價、物料選擇到現場施工，我們用清晰流程和可靠工藝，幫你一步步把新家做好。</span>
        </p>

        <div class="hero__actions">
          <a class="btn btn-primary" href={waLink} target="_blank" rel="noopener">
            WhatsApp 立即要價
            <span class="btn__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 241.19">
                <path
                  d="M205,35.05A118.61,118.61,0,0,0,120.46,0C54.6,0,1,53.61,1,119.51a119.5,119.5,0,0,0,16,59.74L0,241.19l63.36-16.63a119.43,119.43,0,0,0,57.08,14.57h0A119.54,119.54,0,0,0,205,35.07v0ZM120.5,219A99.18,99.18,0,0,1,69.91,205.1l-3.64-2.17-37.6,9.85,10-36.65-2.35-3.76A99.37,99.37,0,0,1,190.79,49.27,99.43,99.43,0,0,1,120.49,219ZM175,144.54c-3-1.51-17.67-8.71-20.39-9.71s-4.72-1.51-6.75,1.51-7.72,9.71-9.46,11.72-3.49,2.27-6.45.76-12.63-4.66-24-14.84A91.1,91.1,0,0,1,91.25,113.3c-1.75-3-.19-4.61,1.33-6.07s3-3.48,4.47-5.23a19.65,19.65,0,0,0,3-5,5.51,5.51,0,0,0-.24-5.23C99,90.27,93,75.57,90.6,69.58s-4.89-5-6.73-5.14-3.73-.09-5.7-.09a11,11,0,0,0-8,3.73C67.48,71.05,59.75,78.3,59.75,93s10.69,28.88,12.19,30.9S93,156.07,123,169c7.12,3.06,12.68,4.9,17,6.32a41.18,41.18,0,0,0,18.8,1.17c5.74-.84,17.66-7.21,20.17-14.18s2.5-13,1.75-14.19-2.69-2.06-5.7-3.59l0,0Z"
                ></path>
              </svg>
            </span>
          </a>
          <a class="btn" href="/projects">查看全部案例</a>
        </div>

        <div class="hero__stats">
          <div class="stat">
            <div class="stat__num">8+</div>
            <div class="stat__label">年經驗</div>
          </div>
          <div class="stat">
            <div class="stat__num">一站式</div>
            <div class="stat__label">設計與施工</div>
          </div>
          <div class="stat">
            <div class="stat__num">透明</div>
            <div class="stat__label">報價與流程</div>
          </div>
        </div>
      </div>

      <div class="hero__media">
        <Image
          src={Home}
          alt="ALL OUT DESIGN 室內設計與裝修工程"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="section">
    <div class="container">
      <div class="sectionHead">
        <h2 class="sectionTitle">精選案例 <span class="sectionTitle__en">Featured Projects</span></h2>
        <a class="sectionLink" href="/projects">查看全部案例 →</a>
      </div>

      <div class="grid3">
        {featured.map((p) => (
          <a class="projectCard" href={p.href}>
            <Image
              class="projectCard__img"
              src={p.image}
              alt={p.title}
              loading="eager"
              decoding="async"
            />
            <div class="projectCard__body">
              <div class="projectCard__title">{p.title}</div>
              <div class="projectCard__sub muted">{p.subtitle}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section--soft">
    <div class="container">
      <div class="sectionHead">
        <h2 class="sectionTitle">我們的流程 <span class="sectionTitle__en">Our Process</span></h2>
      </div>

      <div class="grid4">
        {process.map((s) => (
          <div class="stepCard">
            <div class="stepCard__no">{s.no}</div>
            <div class="stepCard__zh">{s.zh}</div>
            <div class="stepCard__en muted">{s.en}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="sectionHead">
        <h2 class="sectionTitle">我們的服務 <span class="sectionTitle__en">Our Services</span></h2>
      </div>

      <div class="grid3">
        {services.map((s) => (
          <div class="serviceCard">
            <div class="serviceCard__title">{s.zh} <span class="serviceCard__en muted">{s.en}</span></div>
            <ul class="serviceCard__list">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section--soft">
    <div class="container">
      <div class="sectionHead">
        <h2 class="sectionTitle">客戶讚譽 <span class="sectionTitle__en">Client Testimonials</span></h2>
      </div>

      <div class="grid2">
        <div class="quoteCard">
          <div class="quoteMark">“</div>
          <p>報價清晰、傢俬質素高！</p>
          <div class="muted">— 青衣曉峰園客人</div>
        </div>
        <div class="quoteCard">
          <div class="quoteMark">“</div>
          <p>設計貼地，團隊都係比較後生，溝通上冇問題。</p>
          <div class="muted">— 東涌翔東邨客人</div>
        </div>
      </div>
    </div>
  </section>

  <!-- STICKY CTA BAR -->
  <div class="ctaBar">
    <div class="ctaBar__inner">
      <div class="ctaBar__text">立即約免費初步諮詢 <span class="muted">Get Your Free Consultation</span></div>
      <a class="ctaBar__btn" href={waLink} target="_blank" rel="noopener">WhatsApp 立即聯絡</a>
    </div>
  </div>
</SiteLayout>
