<script>
  const weChatOpen = document.querySelector<HTMLButtonElement>(".js-wechat-open");
  const weChatModal = document.querySelector<HTMLElement>(".js-wechat-modal");
  const weChatCloseButtons = document.querySelectorAll<HTMLButtonElement>(".js-wechat-close");

  const openWeChatModal = () => {
    weChatModal?.classList.add("is-open");
    weChatModal?.setAttribute("aria-hidden", "false");
    document.documentElement.classList.add("has-modal");
  };

  const closeWeChatModal = () => {
    weChatModal?.classList.remove("is-open");
    weChatModal?.setAttribute("aria-hidden", "true");
    document.documentElement.classList.remove("has-modal");
  };

  weChatOpen?.addEventListener("click", openWeChatModal);
  weChatCloseButtons.forEach((button) => button.addEventListener("click", closeWeChatModal));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeWeChatModal();
  });
</script>

<style>
  .qr-page {
    min-height: calc(100svh - 180px);
    padding: 24px 0 48px;
    background: #fff;
  }

  .qr-card {
    width: min(100%, 520px);
    margin: 0 auto;
    padding: 0 16px;
  }

  .qr-links {
    display: grid;
    gap: 12px;
  }

  .qr-link {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 24px;
    gap: 12px;
    align-items: center;
    min-height: 74px;
    padding: 14px;
    border: 1px solid #e3e8ec;
    border-radius: 12px;
    background: #fff;
    color: #111;
    box-shadow: 0 8px 22px rgba(15, 42, 68, 0.06);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .qr-link--button {
    width: 100%;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .qr-link:hover {
    transform: translateY(-1px);
    border-color: #c9d8e3;
    color: #111;
    box-shadow: 0 14px 30px rgba(15, 42, 68, 0.1);
  }

  .qr-link__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #f0f5f7;
    color: #0f2a44;
  }

  .qr-link__icon svg {
    display: block;
    width: 26px;
    height: 26px;
    fill: currentColor;
  }

  .qr-link__icon--whatsapp svg {
    fill: #25d366;
  }

  .qr-link__icon--wechat svg {
    fill: #1aad19;
  }

  .qr-link__copy {
    display: grid;
    min-width: 0;
    gap: 2px;
  }

  .qr-link__label {
    overflow-wrap: anywhere;
    font-weight: 800;
    line-height: 1.35;
  }

  .qr-link__detail {
    overflow-wrap: anywhere;
    color: inherit;
    font-size: 14px;
    line-height: 1.45;
    opacity: 0.68;
  }

  .qr-link__arrow {
    justify-self: end;
    color: inherit;
    font-size: 20px;
    line-height: 1;
    opacity: 0.62;
  }

  .wechat-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .wechat-modal.is-open {
    display: flex;
  }

  .wechat-modal__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.58);
    cursor: pointer;
  }

  .wechat-modal__dialog {
    position: relative;
