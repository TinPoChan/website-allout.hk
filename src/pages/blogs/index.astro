---
import SiteLayout from "../../components/SiteLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const posts = (await getCollection("blogs"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<SiteLayout title="專欄 | ALL OUT DESIGN" description="裝修設計與工程知識分享。">
  <section class="page-shell">
    <div class="container">
      <header class="page-hero">
        <p class="eyebrow">Blogs</p>
        <h1>專欄</h1>
        <p>裝修設計與工程知識分享</p>
      </header>

      <div class="blog-list">
        {posts.map((p) => (
          <a href={`/blogs/${p.id}`} class="blog-card">
            {p.data.coverImage && (
              <Image
                src={p.data.coverImage}
                alt={`${p.data.title} 封面圖片`}
                class="blog-card__image"
                width={360}
                height={240}
                loading="eager"
                decoding="async"
              />
            )}

            <div class="blog-card__content">
              <div class="blog-card__title">{p.data.title}</div>
              <div class="blog-card__summary">{p.data.summary}</div>
              <div class="blog-card__meta">
                {p.data.date}
                {p.data.tags?.length ? ` · ${p.data.tags.join("、")}` : ""}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .blog-list {
    display: grid;
    gap: 16px;
  }

  .blog-card {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 20px;
    align-items: stretch;
    border: 1px solid #eee;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    min-height: 180px;
    display: block;
    object-fit: cover;
  }

  .blog-card__content {
    padding: 20px 20px 20px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .blog-card__title {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.5;
  }

  .blog-card__summary {
    color: #666;
    margin-top: 8px;
    line-height: 1.7;
  }

  .blog-card__meta {
    color: #999;
    margin-top: 10px;
    font-size: 13px;
  }

  .blog-card:hover {
    border-color: #ccc;
  }

  @media (max-width: 700px) {
    .blog-card {
      grid-template-columns: 1fr;
    }

    .blog-card__image {
      height: auto;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .blog-card__content {
      padding: 16px;
    }
  }
</style>
