---
import SiteLayout from "../../components/SiteLayout.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blogs", (entry) => !entry.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---

<SiteLayout
  title={`${post.data.title} | ALL OUT DESIGN`}
  description={post.data.summary}
>
  <JsonLd
    type="blog"
    data={{
      title: post.data.title,
      summary: post.data.summary,
      date: post.data.date,
      canonical,
    }}
  />

  <article class="prose">
    <header style="margin-bottom: var(--space-5);">
      <h1 style="margin-bottom: var(--space-2);">{post.data.title}</h1>

      <div class="muted" style="font-size: 13px;">
        {post.data.date}
        {post.data.tags?.length ? ` · ${post.data.tags.join(" / ")}` : ""}
      </div>

      {post.data.coverImage && (
        <Image
          src={post.data.coverImage}
          alt={post.data.title}
          width={1600}
          height={900}
          style="width: 100%; height: auto; border-radius: 16px; margin-top: var(--space-4);"
        />
      )}
    </header>

    <Content />
  </article>
</SiteLayout>