---
import SiteLayout from "../../components/SiteLayout.astro";
import { getCollection } from "astro:content";
import JsonLd from "../../components/JsonLd.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
// const { Content } = await project.render();
---

<SiteLayout
  title={`${project.data.title} | ALL OUT DESIGN`}
  description={project.data.summary}
  ogImage={project.data.coverImage?.src}
>
  <JsonLd
    type="project"
    data={{
      title: project.data.title,
      summary: project.data.summary,
      coverImage: project.data.coverImage?.src,
      canonical: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(),
    }}
  />

  <article style="max-width: 920px; margin: 0 auto;" >
    <h1 style="margin:0 0 10px;">{project.data.title}</h1>
    <div style="color:#999; font-size:13px; margin-bottom:16px;">
      {project.data.date}
      {project.data.location ? ` · ${project.data.location}` : ""}
      {project.data.size ? ` · ${project.data.size}` : ""}
    </div>

      {project.data.coverImage && (
        <Image
          class="project-cover"
          src={project.data.coverImage}
          alt={project.data.title}
          layout="constrained"
          width={900}
          height={600}
          loading="eager"
          fetchpriority="high"
        />
      )}

      {project.data.youtubeId && (
        <section class="project-video">
          <h2>影片導覽</h2>

          <div
            class="project-video__player"
            data-youtube-id={project.data.youtubeId}
            data-video-title={`${project.data.title} 影片導覽`}
          >
            <button
              class="project-video__placeholder"
              type="button"
              aria-label={`${project.data.title} 影片導覽`}
            >
              <img
                src={`https://i.ytimg.com/vi/${project.data.youtubeId}/sddefault.jpg`}
                alt={`${project.data.title} 影片封面`}
                loading="lazy"
                decoding="async"
              />
              <span class="project-video__play" aria-hidden="true">▶</span>
            </button>
          </div>
        </section>
      )}

    <!-- <Content /> -->

    {project.data.details?.length ? (
  <section class="project-details">
    <h2>項目重點</h2>

    <div class="project-details__grid">
      {project.data.details.map((section) => (
        <article class="project-detail-card">
          <h3>{section.title}</h3>
          <ul>
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
) : null}

    {project.data.gallery?.length ? (
      <section class="project-gallery-section">
        <h2>完工圖片</h2>

        <div class="project-gallery">
          {project.data.gallery.map((image) => (
            <a class="project-gallery__item" href={image.src} target="_blank" rel="noopener">
              <Image
                class="project-gallery__image"
                src={image}
                alt={project.data.title}
                width={600}
                height={800}
                loading="lazy"
                decoding="async"
              />
            </a>
          ))}
        </div>
      </section>
    ) : null}

    
  </article>
</SiteLayout>

<style>
.project-gallery {
  columns: 3 260px;
  column-gap: 12px;
  margin: 0 0 18px;
}

.project-gallery__item {
  display: block;
  break-inside: avoid;
  margin: 0 0 12px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #eee;
}

.project-cover {
  width: 100%;
  height: 420px;
  object-fit: cover;
  object-position: center;
  border-radius: 14px;
  border: 1px solid #eee;
  margin: 10px 0 18px;
  display: block;
}

.project-gallery__image {
  display: block;
  width: 100%;
  height: auto;
}

.project-video {
  margin: 32px 0;
}

.project-video h2 {
  margin: 0 0 14px;
}

.project-details {
  margin: 36px 0;
}

.project-details h2 {
  margin: 0 0 18px;
  font-size: 1.6rem;
}

.project-details__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.project-detail-card {
  border: 1px solid #e8e8e8;
  border-radius: 16px;
  padding: 22px 24px;
  background: #fff;
}

.project-detail-card h3 {
  margin: 0 0 14px;
  font-size: 1.25rem;
}

.project-detail-card ul {
  margin: 0;
  padding-left: 1.2em;
  color: #333;
  line-height: 1.8;
}

.project-detail-card li + li {
  margin-top: 6px;
}

.project-video {
  margin: 32px 0;
}

.project-video h2 {
  margin: 0 0 14px;
}



.project-video__play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72px;
  height: 72px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: rgba(0, 0, 0, 0.72);
  color: #fff;
  font-size: 34px;
  line-height: 1;
}

.project-video {
  margin: 32px 0;
}

.project-video h2 {
  margin: 0 0 14px;
}

.project-video__player {
  width: min(100%, 420px);
  aspect-ratio: 9 / 16;
  margin: 0 auto;
  border-radius: 16px;
  overflow: hidden;
  background: #000;
}

.project-video__placeholder {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 0;
  border: 0;
  background: #000;
  cursor: pointer;
  display: block;
}

.project-video__placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  opacity: 0.92;
}

.project-video__play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 72px;
  height: 72px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: rgba(0, 0, 0, 0.72);
  color: #fff;
  font-size: 34px;
  line-height: 1;
}

.project-video__player :global(iframe) {
  width: 100%;
  height: 100%;
  display: block;
  border: 0;
  background: #000;
}

.project-gallery-section {
  margin: 36px 0 0;
}

.project-gallery-section h2 {
  margin: 0 0 18px;
}


@media (max-width: 768px) {
  .project-details__grid {
    grid-template-columns: 1fr;
  }

  .project-detail-card {
    padding: 18px 20px;
  }

  .project-cover {
    height: 260px;
  }
}

@media (max-width: 900px) {
  .project-gallery {
    columns: 2 220px;
  }
}

@media (max-width: 600px) {
  .project-gallery {
    columns: 1;
  }
}
</style>

<script>
  const videoPlayers = document.querySelectorAll<HTMLElement>(
    ".project-video__player"
  );

  videoPlayers.forEach((player) => {
    const button = player.querySelector<HTMLButtonElement>(
      ".project-video__placeholder"
    );

    button?.addEventListener("click", () => {
      const youtubeId = player.dataset.youtubeId;
      const title = player.dataset.videoTitle || "影片導覽";

      if (!youtubeId) return;

      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;

      player.replaceChildren(iframe);
    });
  });
</script>