---
import SiteLayout from "../../components/SiteLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<SiteLayout title="作品集 | ALL OUT DESIGN" description="裝修設計案例與工程作品集。">
  <h1 style="margin:0 0 10px;">作品集</h1>

  <div class="project-list">
    {projects.map((p) => (
      <a href={`/projects/${p.id}`} class="project-card">
        {p.data.coverImage && (
          <Image
            src={p.data.coverImage}
            alt={`${p.data.title} 封面圖片`}
            class="project-card__image"
            width={360}
            height={240}
            loading="eager"
            decoding="async"
          />
        )}

        <div class="project-card__content">
          <div class="project-card__title">{p.data.title}</div>
          <div class="project-card__summary">{p.data.summary}</div>
          <div class="project-card__meta">
            {p.data.date}{p.data.location ? ` · ${p.data.location}` : ""}
          </div>
        </div>
      </a>
    ))}
  </div>
</SiteLayout>

<style>
  .project-list {
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }

  .project-card {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 20px;
    align-items: stretch;
    border: 1px solid #eee;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    min-height: 180px;
    display: block;
    object-fit: cover;
  }

  .project-card__content {
    padding: 20px 20px 20px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-card__title {
    font-weight: 700;
    font-size: 18px;
    line-height: 1.5;
  }

  .project-card__summary {
    color: #666;
    margin-top: 8px;
    line-height: 1.7;
  }

  .project-card__meta {
    color: #999;
    margin-top: 10px;
    font-size: 13px;
  }

  .project-card:hover {
    border-color: #ccc;
  }

  @media (max-width: 700px) {
    .project-card {
      grid-template-columns: 1fr;
    }

    .project-card__image {
      height: auto;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .project-card__content {
      padding: 16px;
    }
  }
</style>