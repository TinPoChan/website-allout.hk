---
import SiteLayout from "../components/SiteLayout.astro";

const phoneDisplay = "5393 6777";
const waLink = "https://wa.me/85253936777";
const email = "info@allout.hk";

// TODO: 換成你哋真實連結
const facebookLink = "https://www.facebook.com/alloutdesign";
const renoteLink =
  "https://www.xiaohongshu.com/user/profile/58f2f7de82ec39403133d4ac";
---

<SiteLayout title="聯絡 | ALL OUT DESIGN" description="查詢報價與聯絡方式。">
  <section class="contact">
    <div class="contact__intro">
      <p class="eyebrow">Contact</p>
      <h1>聯絡我們</h1>
      <p>
        如果你正計劃裝修、想了解報價，或者想先傾吓單位情況，
        歡迎用以下方式聯絡我哋。我哋會盡快回覆你。
      </p>
    </div>

    <!--Svg License: All icons on this site can be used for personal, commercial, and client projects without attribution - uxwing.com -->
