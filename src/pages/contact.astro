                class="cls-3"
                d="M102.31,30.86,78,5.74V5.49H12.44V46h0L46.66,76.6l.15.14L58.36,87.06,105,46.36v-10l-2.64-5.49Z"
              />
              <path
                class="cls-4"
                d="M58.7,13.35A25.26,25.26,0,1,1,33.44,38.61,25.26,25.26,0,0,1,58.7,13.35Z"
              />
              <path
                class="cls-5"
                d="M50.86,34.6l4.47,4.22L65.91,28.1c.88-.89,1.43-1.6,2.51-.49l3.51,3.59c1.15,1.14,1.09,1.81,0,2.87L57.34,48.43c-2.29,2.25-1.89,2.39-4.22.08L45,40.39a1,1,0,0,1,.1-1.58l4.07-4.22c.62-.65,1.11-.59,1.74,0Z"
              />
            </svg>
          </span>
        </span>

        <strong>{email}</strong>
        <span class="contact-card__hint">
          適合合作查詢、文件往來或較詳細的項目資料
        </span>
      </a>

      <a
        class="contact-card"
        href={facebookLink}
        target="_blank"
        rel="noopener"
      >
        <span class="contact-card__label">
          Facebook
          <span class="contact-card__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 509 509">
              <g fill-rule="nonzero">
                <path
                  fill="#0866FF"
                  d="M509 254.5C509 113.94 395.06 0 254.5 0S0 113.94 0 254.5C0 373.86 82.17 474 193.02 501.51V332.27h-52.48V254.5h52.48v-33.51c0-86.63 39.2-126.78 124.24-126.78 16.13 0 43.95 3.17 55.33 6.33v70.5c-6.01-.63-16.44-.95-29.4-.95-41.73 0-57.86 15.81-57.86 56.91v27.5h83.13l-14.28 77.77h-68.85v174.87C411.35 491.92 509 384.62 509 254.5z"
                ></path>
                <path
                  fill="#fff"
                  d="M354.18 332.27l14.28-77.77h-83.13V227c0-41.1 16.13-56.91 57.86-56.91 12.96 0 23.39.32 29.4.95v-70.5c-11.38-3.16-39.2-6.33-55.33-6.33-85.04 0-124.24 40.16-124.24 126.78v33.51h-52.48v77.77h52.48v169.24c19.69 4.88 40.28 7.49 61.48 7.49 10.44 0 20.72-.64 30.83-1.86V332.27h68.85z"
                ></path>
              </g>
            </svg>
          </span>
        </span>

        <strong>關注我們</strong>
        <span class="contact-card__hint">
          查看更多裝修案例、設計細節及日常分享
        </span>
      </a>

      <a class="contact-card" href={renoteLink} target="_blank" rel="noopener">
        <span class="contact-card__label">
          小紅書
          <span class="contact-card__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 446 511.46"
            >
              <path
                fill="#F10100"
                fill-rule="nonzero"
                d="M446 511.46H265.96l-67.09-152.21h-35.2v152.21H0V0h257.79c117.3 0 175.94 59.73 175.94 179.22 0 81.83-25.37 135.84-76.11 162.03L446 511.46zM163.67 130.93v102.3h37.65c19.64 0 33.96-2.05 42.96-6.14s13.51-13.5 13.51-28.23V165.3c0-14.73-4.51-24.14-13.51-28.24-9-4.08-23.32-6.13-42.96-6.13h-37.65z"
              />
            </svg>
          </span>
        </span>

        <strong>查看更多作品</strong>
        <span class="contact-card__hint">瀏覽更多案例、靈感及項目分享</span>
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .contact {
    max-width: 980px;
    margin: 0 auto;
    padding: 72px 20px;
  }

  .contact__intro {
    max-width: 720px;
    margin-bottom: 36px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #666;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact h1 {
    margin: 0 0 16px;
    font-size: clamp(34px, 4vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .contact__intro p:not(.eyebrow) {
    margin: 0;
    color: #444;
    font-size: 18px;
    line-height: 1.8;
  }

  .contact__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid #e6e6e6;
    border-radius: 20px;
    color: inherit;
    text-decoration: none;
    background: #fff;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .contact-card:hover {
    transform: translateY(-2px);
    border-color: #cfcfcf;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.06);
  }

  .contact-card--primary {
    background: #0d2b45;
    color: #fff;
    border-color: #0d2b45;
  }

  .contact-card__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    opacity: 0.72;
    font-size: 14px;
  }

  .contact-card__icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transform: translateY(-2px); // 微調icon位置，使其與文字更好地對齊
  }

  .contact-card__icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: #25d366;
  }

  .contact-card strong {
    font-size: 24px;
    line-height: 1.2;
  }

  .contact-card__hint {
    color: inherit;
    opacity: 0.72;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .contact {
      padding: 48px 20px;
    }

    .contact__cards {
      grid-template-columns: 1fr;
    }

    .contact__intro p:not(.eyebrow) {
      font-size: 16px;
    }
  }
</style>
```
