      <a
        class="contact-card contact-card--primary"
        href={waLink}
        target="_blank"
        rel="noopener"
      >
        <span class="contact-card__label">
          WhatsApp 查詢
          <span class="contact-card__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 241.19">
              <path
                d="M205,35.05A118.61,118.61,0,0,0,120.46,0C54.6,0,1,53.61,1,119.51a119.5,119.5,0,0,0,16,59.74L0,241.19l63.36-16.63a119.43,119.43,0,0,0,57.08,14.57h0A119.54,119.54,0,0,0,205,35.07v0ZM120.5,219A99.18,99.18,0,0,1,69.91,205.1l-3.64-2.17-37.6,9.85,10-36.65-2.35-3.76A99.37,99.37,0,0,1,190.79,49.27,99.43,99.43,0,0,1,120.49,219ZM175,144.54c-3-1.51-17.67-8.71-20.39-9.71s-4.72-1.51-6.75,1.51-7.72,9.71-9.46,11.72-3.49,2.27-6.45.76-12.63-4.66-24-14.84A91.1,91.1,0,0,1,91.25,113.3c-1.75-3-.19-4.61,1.33-6.07s3-3.48,4.47-5.23a19.65,19.65,0,0,0,3-5,5.51,5.51,0,0,0-.24-5.23C99,90.27,93,75.57,90.6,69.58s-4.89-5-6.73-5.14-3.73-.09-5.7-.09a11,11,0,0,0-8,3.73C67.48,71.05,59.75,78.3,59.75,93s10.69,28.88,12.19,30.9S93,156.07,123,169c7.12,3.06,12.68,4.9,17,6.32a41.18,41.18,0,0,0,18.8,1.17c5.74-.84,17.66-7.21,20.17-14.18s2.5-13,1.75-14.19-2.69-2.06-5.7-3.59l0,0Z"
              ></path>
            </svg>
          </span>
        </span>

        <strong>{phoneDisplay}</strong>
        <span class="contact-card__hint"
          >最適合查詢報價、預約睇位或初步了解裝修流程</span
        >
      </a>

      <a class="contact-card" href={`mailto:${email}`}>
        <span class="contact-card__label">
          Email
          <span class="contact-card__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 117.88 122.88"
            >
              <defs>
                <style>
                  .cls-1 { fill: #4d8bba; }
                  .cls-2 { fill: #9fd9f1; }
                  .cls-3,
                  .cls-5 { fill: #fff; }
                  .cls-4 { fill: #00a912; }
                  .cls-4,
                  .cls-5 { fill-rule: evenodd; }
                </style>
              </defs>

              <path
                class="cls-1"
                d="M110.44,41.57a3.59,3.59,0,0,1,2.43-.93,4,4,0,0,1,2.06.6,5.09,5.09,0,0,1,1.26,1.07,7.06,7.06,0,0,1,1.69,4.26v70.64a5.71,5.71,0,0,1-1.66,4h0a5.67,5.67,0,0,1-4,1.66H5.67a5.71,5.71,0,0,1-4-1.66h0a5.62,5.62,0,0,1-1.66-4V46.57a7.1,7.1,0,0,1,1.73-4.32,5.5,5.5,0,0,1,1.26-1,4,4,0,0,1,2-.58,3.59,3.59,0,0,1,2,.57V2.74A2.74,2.74,0,0,1,9.7,0H78.9A2.71,2.71,0,0,1,81,1l28.65,29.59a2.71,2.71,0,0,1,.78,1.9h0v.79c0,.11,0,.22,0,.34s0,.22,0,.33v7.63Z"
              />
              <polygon
                class="cls-2"
                points="112.39 109.75 112.39 47.12 76.6 78.39 112.39 109.75"
              />
              <polygon
                class="cls-2"
                points="40.79 78.69 5.49 47.15 5.49 109.63 40.79 78.69"
              />
              <path
                class="cls-2"
                d="M56.52,92.74,44.9,82.36,5.49,116.9v.31a.17.17,0,0,0,0,.13h0a.22.22,0,0,0,.13,0H112.21a.22.22,0,0,0,.13,0h0a.17.17,0,0,0,0-.13V117L72.45,82,60.15,92.76h0a2.73,2.73,0,0,1-3.62,0Z"
              />
