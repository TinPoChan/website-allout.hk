---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";

const { title, description, ogImage, fullWidth = false } = Astro.props;
const currentPath = Astro.url.pathname;

// 由 astro.config.mjs 的 site 自動組 canonical
const canonicalUrl = Astro.site
  ? new URL(currentPath, Astro.site).toString()
  : undefined;
const absoluteOgImage = ogImage
  ? new URL(ogImage, Astro.site ?? Astro.url.origin).toString()
  : undefined;
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl} ogImage={absoluteOgImage}>
  <Navbar currentPath={currentPath} />

  <main class:list={["site-main", { "site-main--full": fullWidth }]}>
    <slot />
  </main>

  <Footer flush={fullWidth} />
</BaseLayout>
